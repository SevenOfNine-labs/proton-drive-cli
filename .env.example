# proton-drive-cli environment variables (nothing loads this file; it lists
# what the CLI reads, see docs/operations/configuration.md).

# Credential store `login` saves the session tokens and key password in:
# pass-cli (default) or git-credential; --credential-store wins over this.
# Later commands use the store recorded in the session.
PROTON_CREDENTIAL_STORE=pass-cli
# Credential host of the session entry (default proton-drive-cli.invalid).
PROTON_CREDENTIAL_HOST=
# pass-cli binary (default: pass-cli on PATH).
PROTON_PASS_CLI_BIN=
# Git Credential Manager store, checked to encrypt at rest (git-credential store).
GCM_CREDENTIAL_STORE=
# Inherited by pass-cli: on Linux, dbus keeps its key across reboots and login
# sessions (pass-cli docs, get-started/configuration.md, Secure key storage).
PROTON_PASS_LINUX_KEYRING=
# Proton x-pm-appversion override; must match
# external-drive-{name}@{major.minor.patch}[-stable|beta|alpha][+build]
# (default external-drive-protonlfscli@<package.json version>).
PROTON_DRIVE_CLI_APP_VERSION=
# Entry point `doctor` checks (default: the running script).
PROTON_DRIVE_CLI_BIN=
# Redacted [AUTH_TRACE] lines on stderr (1/true/yes/on) and their correlation id.
PROTON_AUTH_TRACE=
PROTON_AUTH_TRACE_ID=
# Debug output (stack traces, bridge logs below ERROR level).
DEBUG=false

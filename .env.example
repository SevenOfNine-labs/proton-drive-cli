# proton-drive-cli environment variables (nothing loads this file; it lists
# what the CLI reads, see docs/operations/configuration.md).

# Key-password provider `login` stores the key password in: pass-cli
# (default) or git-credential; --key-password-provider wins over this. Later
# commands use the provider recorded in the session.
PROTON_KEY_PASSWORD_PROVIDER=pass-cli
# Host/key of the key-password entry (default proton-drive-key.proton-lfs-cli.local).
PROTON_KEY_PASSWORD_HOST=
# pass-cli binary (default: pass-cli on PATH).
PROTON_PASS_CLI_BIN=
# Proton x-pm-appversion override; must match
# external-drive-{name}@{major.minor.patch}[-stable|beta|alpha][+build]
# (default external-drive-protonlfscli@<package.json version>).
PROTON_DRIVE_CLI_APP_VERSION=
# Entry point `doctor` checks (default: the running script).
PROTON_DRIVE_CLI_BIN=
# Redacted [AUTH_TRACE] lines on stderr (1/true/yes/on) and their correlation id.
PROTON_AUTH_TRACE=
PROTON_AUTH_TRACE_ID=
# Debug output (stack traces, bridge logs below ERROR level).
DEBUG=false

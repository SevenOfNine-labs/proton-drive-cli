{
  "name": "@sevenofnine-ai/proton-drive-cli",
  "version": "0.1.2",
  "private": true,
  "main": "dist/index.js",
  "description": "End-to-end encrypted CLI for Proton Drive with Git LFS bridge support",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-runtime.mjs",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "watch": "tsc --watch",
    "install-global": "yarn build && yarn link",
    "uninstall-global": "yarn unlink",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "npx http-server docs/api -p 8080"
  },
  "bin": "./dist/index.js",
  "keywords": [
    "proton",
    "drive",
    "cli",
    "upload",
    "download",
    "encryption",
    "e2ee",
    "git-lfs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenOfNine-labs/proton-drive-cli.git"
  },
  "bugs": {
    "url": "https://github.com/SevenOfNine-labs/proton-drive-cli/issues"
  },
  "homepage": "https://github.com/SevenOfNine-labs/proton-drive-cli#readme",
  "author": "Proton Drive CLI Contributors",
  "license": "MIT",
  "packageManager": "yarn@4.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ky": "^1.14.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@protontech/crypto": "^2.0.0",
    "@protontech/drive-sdk": "portal:./submodules/sdk/client/js",
    "boxen": "^7.1.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "core-js": "^3.49.0",
    "fs-extra": "^11.3.2",
    "inquirer": "^8.2.7",
    "mime-types": "^3.0.2",
    "open": "^11.0.4",
    "openpgp": "npm:@protontech/openpgp@^6.3.1",
    "ora": "^9.0.0",
    "p-retry": "^9.0.0",
    "proper-lockfile": "^4.1.2",
    "shell-quote": "^1.12.0",
    "write-file-atomic": "^6.0.0"
  },
  "resolutions": {
    "lodash": "^4.18.1"
  }
}

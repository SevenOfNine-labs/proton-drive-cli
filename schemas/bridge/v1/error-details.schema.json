{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sevenofnine-labs.github.io/proton-drive-cli/schemas/bridge/v1/error-details.schema.json",
  "title": "proton-drive-cli bridge error details",
  "description": "Object JSON-encoded into the `details` string of a failure envelope. errorCode is always present and is a key of error-code-map.json; the remaining properties are present when the failure carries them. Further AppError details (statusCode, apiError, sdkError, ...) may appear.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "errorCode"
  ],
  "properties": {
    "errorCode": {
      "type": "string",
      "enum": [
        "AUTH_FAILED",
        "SESSION_EXPIRED",
        "CREDENTIALS_UNAVAILABLE",
        "NETWORK_ERROR",
        "TIMEOUT",
        "CONNECTION_REFUSED",
        "API_ERROR",
        "INSUFFICIENT_SCOPE",
        "RATE_LIMITED",
        "QUOTA_EXCEEDED",
        "NOT_FOUND",
        "FILE_NOT_FOUND",
        "FILE_TOO_LARGE",
        "PERMISSION_DENIED",
        "DISK_FULL",
        "UPLOAD_FAILED",
        "DOWNLOAD_FAILED",
        "ENCRYPTION_FAILED",
        "DECRYPTION_FAILED",
        "INVALID_FILE",
        "PATH_NOT_FOUND",
        "INVALID_PATH",
        "NOT_A_FOLDER",
        "CAPTCHA_REQUIRED",
        "UNKNOWN_ERROR",
        "VALIDATION_ERROR",
        "OPERATION_CANCELLED"
      ]
    },
    "captchaUrl": {
      "type": "string"
    },
    "captchaToken": {
      "type": "string"
    },
    "verificationMethods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "string"
    },
    "retryAfter": {
      "type": "number"
    },
    "protonCode": {
      "type": "number"
    },
    "credentialStore": {
      "type": "string",
      "enum": [
        "git-credential",
        "pass-cli"
      ]
    },
    "credentialHost": {
      "type": "string"
    },
    "storeError": {
      "type": "string",
      "description": "CREDENTIALS_UNAVAILABLE: the credential store's reason why the session entry could not be read or saved, with secrets redacted."
    }
  }
}

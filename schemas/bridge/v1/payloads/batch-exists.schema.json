{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sevenofnine-labs.github.io/proton-drive-cli/schemas/bridge/v1/payloads/batch-exists.schema.json",
  "title": "proton-drive-cli bridge batch-exists payload",
  "description": "Success payload of `bridge batch-exists`: one boolean per requested OID (keys are the OIDs exactly as sent).",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Fa-f0-9]{64}$" },
      "additionalProperties": { "type": "boolean" }
    }
  }
}

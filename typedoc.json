{
  "entryPoints": [
    "src/index.ts",
    "src/cli/bridge.ts",
    "src/cli/bridge-helpers.ts",
    "src/cli/login.ts",
    "src/cli/doctor.ts",
    "src/auth/index.ts",
    "src/auth/browser-fork.ts",
    "src/auth/key-password-store.ts",
    "src/auth/session.ts",
    "src/auth/token-expiry.ts",
    "src/api/auth.ts",
    "src/api/http-client.ts",
    "src/bridge/protocol.ts",
    "src/credentials/types.ts",
    "src/types/auth.ts",
    "src/utils/retry.ts",
    "src/errors/types.ts",
    "src/errors/classify.ts"
  ],
  "out": "docs/api",
  "name": "Proton Drive CLI API Documentation",
  "includeVersion": true,
  "readme": "README.md",
  "plugin": [],
  "entryPointStrategy": "expand",
  "navigationLinks": {
    "GitHub": "https://github.com/SevenOfNine-labs/proton-drive-cli"
  },
  "categorizeByGroup": true,
  "categoryOrder": [
    "CLI Commands",
    "Authentication",
    "Drive Operations",
    "Utilities",
    "Error Handling",
    "*"
  ],
  "sort": [
    "kind",
    "instance-first",
    "alphabetical"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**"
  ],
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeInternal": false,
  "hideGenerator": false,
  "searchInComments": true,
  "cleanOutputDir": true
}
